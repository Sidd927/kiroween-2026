{
 "binding_id": "lab-e",
 "description": "Lifeline Pathology & Imaging haemogram layout: two result columns per line, '!' abnormal marker, bracketed reference range.",
 "layout": {
  "anchors": [
   "^LIFELINE PATHOLOGY & IMAGING",
   "Sex/Age:",
   "Report generated by LabSys"
  ]
 },
 "fields": {
  "patient_id": {
   "regex": "Lab ID:\\s+(?P<v>LL-\\d{4}-\\d+)\\s*$",
   "type": "string",
   "required": true,
   "pattern": "LL-\\d{4}-\\d+"
  },
  "patient_name": {
   "regex": "^Patient:\\s+(?P<v>\\S.*?)\\s+Sex/Age:",
   "type": "string",
   "required": true
  },
  "patient_age": {
   "regex": "Sex/Age:\\s+[MF]/(?P<v>\\d+)\\b",
   "type": "integer",
   "required": true
  },
  "patient_sex": {
   "regex": "Sex/Age:\\s+(?P<v>[MF])/",
   "type": "enum",
   "enum_map": {
    "M": "male",
    "F": "female"
   },
   "required": true
  },
  "collected": {
   "regex": "Drawn:\\s+(?P<v>[A-Z][a-z]+ \\d{1,2}, \\d{4})",
   "type": "date",
   "format": "%B %d, %Y",
   "required": true
  }
 },
 "results": {
  "start": "^HAEMOGRAM\\s*$",
  "end": "^_{20,}$",
  "skip_lines": [
   "^\\s*$"
  ],
  "row": "(?P<label>MCHC|MCH|MCV|Hb|RBC|WBC|PLT|HCT)[ ]+(?P<value>\\d+(?:\\.\\d+)?)(?:[ ]+(?P<flag>!))?[ ]+(?P<unit>[^\\s\\[\\]]+)[ ]+\\[(?P<ref_low>\\d+(?:\\.\\d+)?)-(?P<ref_high>\\d+(?:\\.\\d+)?)\\]",
  "labels": {
   "Hb": "HGB",
   "RBC": "RBC",
   "WBC": "WBC",
   "PLT": "PLT",
   "HCT": "HCT",
   "MCV": "MCV",
   "MCH": "MCH",
   "MCHC": "MCHC"
  },
  "flags": {
   "!": "A"
  },
  "min_rows": 1,
  "max_rows": 16
 },
 "version": 3,
 "compiled": {
  "compiler": "spoolgeist_h.compile/1",
  "header": [
   {
    "regex": "^LIFELINE PATHOLOGY & IMAGING",
    "source": "anchor"
   },
   {
    "regex": "Sex/Age:",
    "source": "anchor"
   },
   {
    "exact": "______________________________________________________________________________"
   }
  ],
  "identity_index": 0,
  "template_lines": [
   "! = outside reference interval Report generated by LabSys 3.1",
   "HAEMOGRAM",
   "SYNTHETIC SAMPLE - NOT A REAL PATIENT",
   "______________________________________________________________________________"
  ],
  "continuation_len": null,
  "promoted_required": [
   "patient_age",
   "patient_sex"
  ],
  "date_formats": {
   "collected": {
    "format": "%B %d, %Y",
    "day_month_order_ambiguous_format": false,
    "samples_disambiguate": null,
    "n_strings": 14
   }
  }
 }
}
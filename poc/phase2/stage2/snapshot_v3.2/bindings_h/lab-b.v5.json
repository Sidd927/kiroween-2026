   "^={10,}$",
   "^\\s*\\(continued\\)$",
   "^\\s*CITY DIAGNOSTIC CENTRE$",
   "^\\s*Plot 7, MIDC Area, Aurangabad - 431001$",
   "^Reg\\. No\\s*:",
   "^Name\\s*:",
   "^Sample collected on\\s*:",
   "^Referred by\\s*:",
   "^\\s*Page \\d+ of \\d+$",
   "^Investigation\\s+Value\\s+Units\\s+Biological Ref\\.$",
   "^Values in bold are outside the biological reference interval\\.$"
  ],
  "row": "^(?P<label>[A-Za-z][A-Za-z /]*?) \\.{2,} +(?P<value>\\d+(?:\\.\\d+)?) +(?P<unit>\\S+) +(?P<ref_low>\\d+(?:\\.\\d+)?)-(?P<ref_high>\\d+(?:\\.\\d+)?)$",

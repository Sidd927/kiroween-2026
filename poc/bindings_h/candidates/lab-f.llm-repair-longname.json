{
 "binding_id": "lab-f",
 "description": "Medilink Reference Lab report: PT/MRN header, COLLECTED line, TEST NAME (UNITS) RESULT FLAG REF table.",
 "layout": {
  "anchors": [
   "^MEDILINK REFERENCE LAB\\s+-\\s+ACCESSION",
   "^TEST NAME \\(UNITS\\)\\s+RESULT\\s+FLAG\\s+REF$",
   "^END OF REPORT$"
  ]
 },
 "fields": {
  "patient_id": {
   "regex": "^PT:\\s.*?\\sMRN\\s+(?P<v>\\d{6,10})\\b",
   "type": "string",
   "required": true,
   "pattern": "\\d{6,10}"
  },
  "patient_name": {
   "regex": "^PT:\\s+(?P<v>\\S.*?)\\s+MRN\\s+\\d",
   "type": "string",
   "required": true
  },
  "patient_age": {
   "regex": "\\bAGE:\\s*(?P<v>\\d{1,3})Y\\b",
   "type": "integer",
   "required": false
  },
  "patient_sex": {
   "regex": "\\bSEX:\\s*(?P<v>[MF])$",
   "type": "enum",
   "enum_map": {
    "M": "male",
    "F": "female"
   },
   "required": false
  },
  "collected": {
   "regex": "^COLLECTED\\s+(?P<v>\\d{2}/\\d{2}/\\d{4} \\d{4})\\b",
   "type": "date",
   "format": "%m/%d/%Y %H%M",
   "required": true
  }
 },
 "results": {
  "start": "^TEST NAME \\(UNITS\\)\\s+RESULT\\s+FLAG\\s+REF$",
  "end": "^END OF REPORT$",
  "skip_lines": [
   "^\\s*$",
   "^=+$",
   "^-+$",
   "^TEST NAME \\(UNITS\\)\\s+RESULT\\s+FLAG\\s+REF$",
   "^MEDILINK REFERENCE LAB\\s+-\\s+ACCESSION \\d+$",
   "^PT:\\s.*\\sMRN\\s+\\d+\\s+AGE:.*$",
   "^COLLECTED\\s+\\d{2}/\\d{2}/\\d{4} \\d{4}\\s+RECEIVED\\s+\\d{2}/\\d{2}/\\d{4} \\d{4}$"
  ],
  "row": "^(?P<label>[A-Z][A-Z ,]*?) \\((?P<unit>[^()\\s]+)\\)[ ]+(?P<value>\\d+(?:\\.\\d+)?)(?:[ ]+(?P<flag>[HL])(?=[ ]))?[ ]+(?P<ref_low>\\d+(?:\\.\\d+)?)-(?P<ref_high>\\d+(?:\\.\\d+)?)$",
  "labels": {
   "HEMOGLOBIN": "HGB",
   "HEMATOCRIT": "HCT",
   "WBC": "WBC",
   "RBC": "RBC",
   "PLATELETS": "PLT",
   "MCV": "MCV",
   "GLUCOSE, FASTING": "GLU",
   "CREATININE": "CREA",
   "ALT": "ALT",
   "AST": "AST"
  },
  "flags": {
   "H": "H",
   "L": "L"
  },
  "min_rows": 1,
  "max_rows": 30
 }
}